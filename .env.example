# Configuración de Kardex. Copia este archivo como `.env` (junto a server.py)
# y llena los valores. El `.env` NO se sube a git: lleva la contraseña sa.

# BD de Kardex (SQL Server 2019). Mismas credenciales que el DB_URL de
# Dossier, cambiando /dossier_local por /kardex.
DB_URL=mssql+pymssql://sa:<password>@10.207.5.10/kardex

# API de datos (PES + Infor) y API de correo (sin uso en v1).
API_BASE_URL=http://10.207.5.9:1303
EMAIL_API_URL=http://10.207.5.9:1999

# Secreto para firmar las sesiones (JWT). OBLIGATORIO: sin él no arranca.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Tabla de usuarios (se reusa la de Dossier: mismo usuario y contraseña).
USUARIOS_TABLE=dossier_local.dbo.usuarios

# Ruta del endpoint de OCs abiertas en el API de datos. Vacío = apagado y la
# UI muestra "N/D". Cuando Compras arregle la consulta:
#   INFOR_PO_PATH=/infor/activePurchaseOrders
INFOR_PO_PATH=

# Zona horaria para mostrar fechas (en BD todo es UTC).
TZ_LOCAL=America/Monterrey
